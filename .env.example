# Vercel runtime values. All values are placeholders; no live mode exists without them.
APP_ORIGIN=http://localhost:3000
# Optional contact mailto: or HTTPS URL; APP_ORIGIN is used when this is blank.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
# Keep this private key only in the server's secret store; never expose it to the browser.
VAPID_PRIVATE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-encoded PEM from Mux, or PKCS8 PEM with escaped newlines.
MUX_SIGNING_PRIVATE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
