# Values go in backend/.env, which git ignores. Until every core key is set the Advertise page keeps its
# local simulation and nothing here is called.
# The exact address readers use. http://localhost:8000 on this Mac, https://your-domain on the VPS.
APP_ORIGIN=http://localhost:8000
# Supabase: sign-in codes and Postgres (no file storage: every file is on R2). Apply supabase/migrations first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2: the issue's videos, posters and podcast, and advertisers' ad videos. Create a bucket and an R2 API
# token with Object Read & Write on that bucket only; it gives the access key ID and secret below. R2_PUBLIC_URL is the
# bucket's public address (a custom domain in production; the r2.dev address is rate-limited and for development only).
# The pipeline reads these too. Without them the site serves the issue's media itself and the Advertise page stays a simulation.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Upstash: rate limits on every write. A missing limiter refuses writes rather than letting them through.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A long random secret. /admin uses it to call this API and to run the clock by hand.
CRON_SECRET=
# Payments, only for buying points. Until one is set nothing is sold: every new email gets 100 free points, every spot
# starts at 1 point, and the page shows buying blurred as "Coming soon".
# Stripe (card, USD): STRIPE_SECRET_KEY is all it needs (sk_test_... to try it, sk_live_... once the account is activated).
# The server asks Stripe whether each checkout was paid. STRIPE_WEBHOOK_SECRET is optional: with a webhook endpoint at
# /api/bought/webhooks/stripe it also takes back refunded and disputed points.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (UPI, INR), optional. With only Stripe set, UPI buyers pay by card.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Rupees per credit for UPI top-ups. You set this; nothing fetches a rate.
USD_INR_RATE=

# The explainer videos (pipeline/explainer/): the scene plan comes from Claude Haiku through the Batch API, about $1-2 a month.
# Empty: every video uses the plan made by rules (headline, a drawing, the summary read out). The pipeline reads this; the backend does not.
ANTHROPIC_API_KEY=
