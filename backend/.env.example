# Values go in backend/.env, which git ignores. Until every core key is set the Advertise page keeps its
# local simulation and nothing here is called.
# The exact address readers use. http://localhost:8000 on this Mac, https://your-domain on the VPS.
APP_ORIGIN=http://localhost:8000
# Supabase: sign-in codes, Postgres, image storage. Apply supabase/migrations first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mux: video upload, signed playback, captions. The token needs Video access plus robots:*.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-encoded PEM from Mux, or PKCS8 PEM with escaped newlines.
MUX_SIGNING_PRIVATE_KEY=
# Upstash: rate limits on every write. A missing limiter refuses writes rather than letting them through.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A long random secret. /admin uses it to call this API and to run the clock by hand.
CRON_SECRET=
# Payments, needed only for adding credits. Card goes through Stripe in USD, UPI through Razorpay in INR.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Rupees per credit for UPI top-ups. You set this; nothing fetches a rate.
USD_INR_RATE=
